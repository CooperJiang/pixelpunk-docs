# 服务器信息
DEPLOY_HOST=110.42.43.216

DEPLOY_USER=root
DEPLOY_PATH=/www/wwwroot/pixelpunk.cc
DEPLOY_PORT=22
# SSH密钥配置 (可选，如果不填写则使用默认的 ~/.ssh/id_rsa)
