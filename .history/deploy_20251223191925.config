# 示例配置：
# DEPLOY_HOST=docs.pixelpunk.com
# DEPLOY_USER=deploy
# DEPLOY_PATH=/var/www/pixelpunk-docs
# DEPLOY_PORT=22
# SSH_KEY=~/.ssh/id_rsa

# 注意：请确保您的SSH公钥已添加到服务器的 ~/.ssh/authorized_keys 文件中
# 生成SSH密钥对命令：ssh-keygen -t rsa -b 4096